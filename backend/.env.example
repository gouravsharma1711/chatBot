# Copy this file to .env for local development and replace the placeholders.
# Do not commit your real .env file or put these secrets in frontend code.

GROQ_API=replace_with_your_groq_api_key
TAVILY_API_KEY=replace_with_your_tavily_api_key

# Local development values. Hosting platforms usually provide PORT themselves.
PORT=3000
FRONTEND_URL=http://127.0.0.1:5500

# Set to development to include stack traces in API error responses.
NODE_ENVIRONMENT=development
